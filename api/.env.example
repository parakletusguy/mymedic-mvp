# ── MyMedic Environment Configuration ─────────────────────────
# SECURITY: Never commit real values. Use secrets manager in prod.

# ── App ───────────────────────────────────────────────────────
APP_NAME=MyMedic
DEBUG=true
API_V1_PREFIX=/api/v1

# ── Database (PostgreSQL) ─────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://mymedic:changeme@localhost:5432/mymedic_db

# ── JWT ───────────────────────────────────────────────────────
# openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── OTP / 2FA ─────────────────────────────────────────────────
OTP_SECRET_KEY=CHANGE_ME_TO_A_BASE32_SECRET
OTP_ISSUER=MyMedic
OTP_DIGITS=6
OTP_INTERVAL=30

# ── Payment Gateway (Paystack) ───────────────────────────────
# Get keys from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── SMTP (Email Verification) ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@mymedic.app
SMTP_PASSWORD=changeme
SMTP_FROM=MyMedic <noreply@mymedic.app>
